# Duplicate launch logs and exploratory Vivado journals.
/logs/
*.jou
!/evidence/wave_export.jou
/evidence/wave_inspect2.log
/evidence/wave_inspect3.log

# Vitis project: retain only reports, raw test vectors, and the waveform
# inputs needed by export_wave.tcl. Do not ignore evidence/*.log or *.dat.
/qgemv_hls/*
!/qgemv_hls/solution1/
/qgemv_hls/solution1/*
!/qgemv_hls/solution1/csim/
!/qgemv_hls/solution1/syn/
!/qgemv_hls/solution1/sim/

/qgemv_hls/solution1/csim/*
!/qgemv_hls/solution1/csim/report/

/qgemv_hls/solution1/syn/*
!/qgemv_hls/solution1/syn/report/
!/qgemv_hls/solution1/syn/verilog/
/qgemv_hls/solution1/syn/verilog/*
!/qgemv_hls/solution1/syn/verilog/qgemv_control_s_axi.v

/qgemv_hls/solution1/sim/*
!/qgemv_hls/solution1/sim/report/
!/qgemv_hls/solution1/sim/tv/
!/qgemv_hls/solution1/sim/qgemv_cosim_random_stall.json
!/qgemv_hls/solution1/sim/verilog/
/qgemv_hls/solution1/sim/verilog/*
!/qgemv_hls/solution1/sim/verilog/qgemv.wdb
!/qgemv_hls/solution1/sim/verilog/qgemv.wcfg
!/qgemv_hls/solution1/sim/verilog/qgemv.protoinst
!/qgemv_hls/solution1/sim/verilog/qgemv.autotb.v

# Independent v3 project: same evidence-only retention policy.
/qgemv_hls_v3/*
!/qgemv_hls_v3/solution1/
/qgemv_hls_v3/solution1/*
!/qgemv_hls_v3/solution1/csim/
!/qgemv_hls_v3/solution1/syn/
!/qgemv_hls_v3/solution1/sim/

/qgemv_hls_v3/solution1/csim/*
!/qgemv_hls_v3/solution1/csim/report/

/qgemv_hls_v3/solution1/syn/*
!/qgemv_hls_v3/solution1/syn/report/
!/qgemv_hls_v3/solution1/syn/verilog/
/qgemv_hls_v3/solution1/syn/verilog/*
!/qgemv_hls_v3/solution1/syn/verilog/qgemv_control_s_axi.v

/qgemv_hls_v3/solution1/sim/*
!/qgemv_hls_v3/solution1/sim/report/
!/qgemv_hls_v3/solution1/sim/tv/
!/qgemv_hls_v3/solution1/sim/qgemv_cosim_random_stall.json
!/qgemv_hls_v3/solution1/sim/verilog/
/qgemv_hls_v3/solution1/sim/verilog/*
!/qgemv_hls_v3/solution1/sim/verilog/qgemv.wdb
!/qgemv_hls_v3/solution1/sim/verilog/qgemv.wcfg
!/qgemv_hls_v3/solution1/sim/verilog/qgemv.protoinst
!/qgemv_hls_v3/solution1/sim/verilog/qgemv.autotb.v
